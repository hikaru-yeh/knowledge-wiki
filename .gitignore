# Private curated wiki contents.
# Public scaffold keeps only README/example placeholders and selected indexes/examples.
wiki-pages/.git/
wiki-pages/**/*.md
!wiki-pages/README.md
!wiki-pages/log.example.md
!wiki-pages/example-topic/
!wiki-pages/example-topic/**
!wiki-pages/index/
!wiki-pages/index/example-index.md
!wiki-pages/index/.gitkeep
!wiki-pages/.gitkeep

# Operational maintenance output from the private working vault
tasks/**
!tasks/
!tasks/maintenance-reports/
!tasks/maintenance-reports/.gitkeep
