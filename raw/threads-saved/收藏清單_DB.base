# 收藏清單_DB

filters:
  and:
    - note["base"] == link("收藏清單_DB.base")
properties:
  file.name:
    displayName: 主題
  網址:
    displayName: 網址
  作者:
    displayName: 作者
  收藏類型:
    displayName: 收藏類型
  加入日期:
    displayName: 加入日期
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 網址
      - 作者
      - 收藏類型
      - 加入日期
