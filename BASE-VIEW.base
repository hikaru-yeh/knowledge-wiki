filters:
  and:
    - file.folder.startsWith("wiki-pages")
    - status == "stub"
views:
  - type: table
    name: 表格
    order:
      - file.name
      - file.folder
      - 網址
    sort:
      - property: file.folder
        direction: ASC
      - property: 網址
        direction: DESC
      - property: author
        direction: DESC
      - property: 收藏類型
        direction: ASC
    columnSize:
      file.name: 263
      note.author: 107
      note.url: 546
